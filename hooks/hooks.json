{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/buddy-session-start.mjs\"",
            "timeout": 20,
            "statusMessage": "Checking on the buddy..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|.*buddy_observe.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/buddy-observe-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/buddy-observe-gate.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the buddy got told..."
          }
        ]
      }
    ]
  }
}
